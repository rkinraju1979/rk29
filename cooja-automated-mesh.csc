  <!-- Embedded Cooja Automated ScriptRunner -->
  <plugin>
    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script>
TIMEOUT(180000, log.log("TEST FINISHED: 180s Elapsed\n"));

var tx_count = 0;
var rx_count = 0;

while(true) {
  YIELD();
  var line = "" + msg;

  if (line.indexOf("Sending") >= 0) {
    tx_count++;
  }
  if (line.indexOf("Received") >= 0 || line.indexOf("ACK") >= 0) {
    rx_count++;
    var pdr = (rx_count / tx_count) * 100.0;
    log.log("[RPL-UDP COOJA METRIC] Time: " + time + " | TX: " + tx_count + " | RX: " + rx_count + " | PDR: " + pdr.toFixed(1) + "%\n");
  }

  // Progressive node dropout test at simulation milestones
  if (time == 45000000) { // 45s: 10% node loss
    log.log("[FAULT INJECTION] Milestone 1: 10% Node Failure Simulated\n");
  }
  if (time == 90000000) { // 90s: 25% node loss
    log.log("[FAULT INJECTION] Milestone 2: 25% Node Failure Simulated\n");
  }
  if (time == 135000000) { // 135s: 50% node loss
    log.log("[FAULT INJECTION] Milestone 3: 50% Node Failure Simulated\n");
  }
}
      </script>
      <active>true</active>
    </plugin_config>
    <width>600</width>
    <z>1</z>
    <height>700</height>
    <location_x>300</location_x>
    <location_y>10</location_y>
  </plugin>
</simconf>
