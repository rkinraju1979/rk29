    org.contikios.cooja.plugins.SimControl
    <width>280</width>
    <z>3</z>
    <height>160</height>
    <location_x>10</location_x>
    <location_y>10</location_y>
  </plugin>
  <plugin>
    org.contikios.cooja.plugins.Visualizer
    <plugin_config>
      <moterelations>true</moterelations>
      <skin>org.contikios.cooja.plugins.skins.IDVisualizerSkin</skin>
      <skin>org.contikios.cooja.plugins.skins.UDGMVisualizerSkin</skin>
      <skin>org.contikios.cooja.plugins.skins.TrafficVisualizerSkin</skin>
      <skin>org.contikios.cooja.plugins.skins.LEDVisualizerSkin</skin>
      <viewport>0.85 0.0 0.0 0.85 30 30</viewport>
    </plugin_config>
    <width>620</width>
    <z>2</z>
    <height>620</height>
    <location_x>10</location_x>
    <location_y>180</location_y>
  </plugin>
  <plugin>
    org.contikios.cooja.plugins.LogListener
    <plugin_config>
      <filter />
      <formatted_time />
      <coloring />
    </plugin_config>
    <width>800</width>
    <z>1</z>
    <height>350</height>
    <location_x>640</location_x>
    <location_y>10</location_y>
  </plugin>
  <plugin>
    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script>
TIMEOUT(180000, log.log("TEST FINISHED: Simulation Time Elapsed\n"));
var tx = 0;
var rx = 0;
while(true) {
  YIELD();
  var line = "" + msg;
  if (line.indexOf("Sending") &gt;= 0 || line.indexOf("TX") &gt;= 0) {
    tx++;
  }
  if (line.indexOf("Received") &gt;= 0 || line.indexOf("ACK") &gt;= 0 || line.indexOf("RX") &gt;= 0) {
    rx++;
    var pdr = (rx / (tx &gt; 0 ? tx : 1)) * 100.0;
    log.log("[RPL-UDP METRIC] Time: " + time + " | TX: " + tx + " | RX: " + rx + " | PDR: " + pdr.toFixed(1) + "%\n");
  }
}
      </script>
      <active>true</active>
    </plugin_config>
    <width>800</width>
    <z>0</z>
    <height>430</height>
    <location_x>640</location_x>
    <location_y>370</location_y>
  </plugin>
</simconf>
